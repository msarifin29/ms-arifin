{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    },
    "outDir": "dist"
  },
  "exclude": [
    "public",
    "node_modules",
    "dist"
  ]
}